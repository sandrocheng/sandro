{
    "manifest_version":3,
    "name":"sandro_hello_world",
    "version":"1.0",
    "description":"hello world 插件",
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "32": "icons/32.png",
        "72": "icons/72.png",
        "128": "icons/128.png",
        "512": "icons/512.png"
    },
    "permissions": ["activeTab","storage"],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ],
    "action":{
        "default_title": "Title-Hello",
        "default_icon":{
            "32": "icons/32.png",
            "72": "icons/72.png",
            "128": "icons/128.png",
            "512": "icons/512.png"
        },
        "default_popup":"/popup/popup.html"
    }
}